.eggs/
*.egg

# Local environment variables and secrets
.env
.env.*
!.env.example

# Runtime request and response files
request.json
runtime_response.json
bdi_trace.json

# Runtime cache and temporary files
cache/
*.log
*.tmp
*.temp

# Docker and compose local override files
docker-compose.override.yml

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Jupyter notebooks checkpoints, if any
.ipynb_checkpoints/

