# For local host execution use localhost.
# For Docker full-stack execution use prosody.
XMPP_DOMAIN=localhost

USER_AGENT_PASSWORD=userpass
SOFTWARE_COORDINATOR_PASSWORD=coordpass
LOCAL_COORDINATOR_PASSWORD=localcoordpass
OFFICIAL_STORE_AGENT_PASSWORD=officialpass
AUTHORIZED_RESELLER_PASSWORD=resellerpass
GRAY_MARKET_AGENT_PASSWORD=graypass
MARKETPLACE_AGENT_PASSWORD=marketpass
VALUE_RANKER_PASSWORD=rankpass
RECOMMENDATION_AGENT_PASSWORD=recommendpass
OUTPUT_AGENT_PASSWORD=outputpass

# CheapShark is enabled by default.
# If the live source fails or returns no useful deals, AuthorizedResellerAgent falls back to mock data.
USE_REAL_CHEAPSHARK=true
CHEAPSHARK_TIMEOUT_SECONDS=8

# Currency conversion is enabled by default.
# ECB is used as the live exchange-rate source.
# If ECB fails, the configured fallback rate below is used.
ENABLE_CURRENCY_CONVERSION=true
CURRENCY_RATE_PROVIDER=ecb
CURRENCY_RATE_TIMEOUT_SECONDS=8
ALLOW_CURRENCY_FALLBACK_RATE=true
FALLBACK_USD_TO_EUR_RATE=0.92
FALLBACK_USD_TO_EUR_RATE_SOURCE=manual_fallback_rate
FALLBACK_USD_TO_EUR_RATE_DATE=2026-05-08
